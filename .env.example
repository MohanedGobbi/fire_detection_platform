VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# Optional — only needed if you're hosting the detection server (server/detect_server.py)
# somewhere reachable over the network, e.g. for a live-detection deploy. Leave unset for
# a demo-only deploy (frontend + built-in demo cameras); it defaults to the local dev server.
# VITE_DETECTION_SERVER=https://your-detection-server.example.com
